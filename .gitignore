# ==========================================================================
# MI BARRIO — archivos que NO se publican
# ==========================================================================

# Dependencias (cualquier nivel: cuentas-mesa, apps, etc.)
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.yarn/cache/
**/.yarn/cache/

# Firebase / emuladores / copias generadas
.firebase/
**/.firebase/
.firebaserc
**/.firebaserc
*-debug.log
**/*-debug.log
ui-debug.log
**/ui-debug.log
**/pruebas-reglas/firestore.rules

# Logs, temporales y salidas de prueba
*.log
*.log.*
test-output.txt
**/test-output.txt
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Cachés
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/
.turbo/
**/.turbo/
.vite/
**/.vite/
__pycache__/
**/__pycache__/
*.pyc

# Respaldos
*.bak
*.backup
*.old
**/*.bak
**/*.backup
**/*.old
backup/
**/backup/
backups/
**/backups/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Entornos y editores
.env
.env.*
!.env.example
.vercel/
.vscode/
.idea/

.vercel
